{
  "name": "apple-login-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Sign in with Apple authentication API for the Unity Android plugin.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:memory": "DATA_STORE=memory REDIS_URL=memory:// APPLE_MOCK=true JWT_SECRET=\"${JWT_SECRET:-dev-only-memory-jwt-secret-change-me}\" APPLE_SERVICES_ID=\"${APPLE_SERVICES_ID:-com.company.login}\" node dist/main.js",
    "check:apple": "node dist/scripts/check-apple-config.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/typeorm": "^10.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.22"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "typescript": "^5.8.2"
  }
}
