NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# memory: 로컬 시연. postgres: PostgreSQL + Redis.
DATA_STORE=memory
REDIS_URL=memory://
DATABASE_URL=postgres://applelogin:applelogin@localhost:5432/applelogin
DB_SYNCHRONIZE=true
TRUST_PROXY=false

# openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
# openssl rand -base64 32
DATA_ENCRYPTION_KEY=

APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_SERVICES_ID=com.company.login
APPLE_PRIVATE_KEY_PATH=./secrets/AuthKey.p8
APPLE_REDIRECT_URI=http://localhost:3000/auth/apple/callback
# 실제 Apple 연동 전에는 true. production 에서는 거부된다.
APPLE_MOCK=true

ANDROID_PACKAGE_NAME=com.company.game
ANDROID_SHA256_FINGERPRINTS=

TICKET_TTL_SEC=60
TRANSACTION_TTL_SEC=600
ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=5184000
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SEC=600
